<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🍔 Canteen App"
        android:textColor="@color/black"
        android:textSize="24sp"
        />

    <EditText
        android:id="@+id/searchBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/title"
        android:layout_marginTop="15dp"
        android:background="@drawable/search_bg"
        android:drawableStart="@android:drawable/ic_menu_search"
        android:drawablePadding="10dp"
        android:hint="Search food..."
        android:padding="12dp"
        />

    <TextView
        android:id="@+id/categoryTitle"
        android:layout_below="@id/searchBar"
        android:layout_marginTop="20dp"
        android:text="Categories"
        android:textSize="18sp"
        android:textColor="@color/black"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <HorizontalScrollView
        android:id="@+id/categoryScroll"
        android:layout_below="@id/categoryTitle"
        android:layout_marginTop="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <!-- Category Item -->
            <TextView

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:background="@drawable/category_bg"
                android:textAllCaps="true"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:padding="12dp"
                android:text="🍔 Burger" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🍕 Pizza"
                android:background="@drawable/category_bg"
                android:textAllCaps="true"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:padding="12dp"
                android:layout_marginEnd="10dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="☕ Tea"
                android:background="@drawable/category_bg"
                android:textAllCaps="true"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:padding="12dp"
                android:layout_marginEnd="10dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🍰 Dessert"
                android:background="@drawable/category_bg"
                android:textAllCaps="true"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:padding="12dp"
                android:layout_marginEnd="10dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🍰 Icecream"
                android:background="@drawable/category_bg"
                android:textAllCaps="true"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:padding="12dp"
                android:layout_marginEnd="10dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🍰 Tacos"
                android:background="@drawable/category_bg"
                android:textAllCaps="true"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:padding="25dp"
                android:layout_marginEnd="10dp"/>
        </LinearLayout>
    </HorizontalScrollView>

    <ScrollView
        android:id="@+id/firstrow"
        android:layout_width="match_parent"
        android:layout_above="@id/bottomNav"
        android:layout_height="match_parent"
        android:layout_below="@id/categoryScroll"
        android:layout_marginTop="16dp">

        <GridLayout
            android:id="@+id/foodGrid"
            android:columnCount="3"
            android:padding="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Item 1 -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp">


                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:src="@drawable/burger"
                    android:scaleType="centerCrop"
                    android:background="@drawable/card_bg"
                    android:clipToOutline="true"/>
            </FrameLayout>

            <!-- Item 2 -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/pizza"
                    android:background="@drawable/card_bg"
                    android:clipToOutline="true"

                    />
            </FrameLayout>

            <!-- Item 3 -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:clipToOutline="true"
                    android:scaleType="centerCrop"
                    android:src="@drawable/coffee"
                    android:background="@drawable/card_bg"/>
            </FrameLayout>

            <!-- Item 4 -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:clipToOutline="true"
                    android:scaleType="centerCrop"
                    android:src="@drawable/noodles"
                    android:adjustViewBounds="true"
                    android:background="@drawable/card_bg"/>
            </FrameLayout>

            <!-- Item 5 -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:clipToOutline="true"
                    android:scaleType="centerCrop"
                    android:background="@drawable/card_bg"
                    android:src="@drawable/croissant"
                    android:adjustViewBounds="true"


                    />
            </FrameLayout>

            <!-- Item 6 -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:clipToOutline="true"
                    android:scaleType="centerCrop"
                    android:src="@drawable/tacos"
                    android:background="@drawable/card_bg"/>
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:clipToOutline="true"
                    android:src="@drawable/rice"
                    android:scaleType="centerCrop"
                    android:adjustViewBounds="true"
                    android:background="@drawable/card_bg"
                    />
            </FrameLayout>

            <!-- Item 5 -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:src="@drawable/sushi"
                    android:clipToOutline="true"
                    android:scaleType="centerCrop"
                    android:background="@drawable/card_bg"/>

            </FrameLayout>

            <!-- Item 6 -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:src="@drawable/pasta"
                    android:clipToOutline="true"
                    android:scaleType="centerCrop"
                    android:background="@drawable/card_bg"/>
            </FrameLayout>
        </GridLayout>
    </ScrollView>
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_alignParentBottom="true"
        android:layout_marginTop="50dp"
        android:layout_marginBottom="0dp"
        android:background="@color/white"
        app:itemIconTint="@color/black"

        app:itemTextColor="@color/black"
        app:menu="@menu/bottom_menu" />
</RelativeLayout>


<shape xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Background color -->
    <solid android:color="#FFFFFF"/>

    <!-- Border -->
    <stroke
        android:width="2dp"
        android:color="@color/orange"/>

    <!-- Rounded corners -->
    <corners android:radius="20dp"/>

    <!-- Inner padding -->
    <padding
        android:left="12dp"
        android:right="12dp"
        android:top="10dp"
        android:bottom="10dp"/>

</shape>